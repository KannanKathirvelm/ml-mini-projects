# Build-time defaults. Override per shell: VITE_APP_FLAVOR=stocks npm run dev
VITE_APP_FLAVOR=upi
# Default server baked into local builds (CI sets VITE_API_URL from the API_URL repo variable instead).
# Free Render service: sleeps after 15 min idle, first request ~1 min. Alternatives: http://10.0.2.2:7860 (emulator -> this Mac),
# a Cloudflare tunnel URL. Users can override it in the app's Settings tab.
VITE_API_URL=https://ml-mini-projects.onrender.com
VITE_MOCK=false
