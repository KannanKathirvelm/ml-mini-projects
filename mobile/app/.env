# Build-time defaults. Override per shell: VITE_APP_FLAVOR=stocks npm run dev
VITE_APP_FLAVOR=upi
# Public HTTPS tunnel to the FastAPI server (changes when the tunnel restarts; override in Settings).
# Emulator -> host alternative: http://10.0.2.2:7860
VITE_API_URL=https://web-subsidiary-makers-infinite.trycloudflare.com
VITE_MOCK=false
